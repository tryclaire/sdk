{
  "name": "@tryclaire/sdk",
  "version": "0.1.0",
  "description": "Typed, server-side client for the read-only Claire Developer API",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "LICENSE", "README.md"],
  "sideEffects": false,
  "repository": { "type": "git", "url": "git+https://github.com/tryclaire/sdk.git" },
  "bugs": { "url": "https://github.com/tryclaire/sdk/issues" },
  "homepage": "https://github.com/tryclaire/sdk#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "node scripts/generate.mjs",
    "check:types": "node scripts/generate.mjs --check",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:types": "tsc -p test/tsconfig.json",
    "test:package": "node scripts/smoke-package.mjs",
    "check": "npm run check:types && npm test && npm run test:types && npm run test:package",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
